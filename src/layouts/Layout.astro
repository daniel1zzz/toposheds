---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;

const siteUrl = "https://toposheds.com";
const ogImage = "/projects/sheds/w1/comp/1.webp";
const ogTitle = "TOPO Sheds & Remodeling";
const ogDescription = "Custom sheds, bathrooms, concrete work & remodels in Tampa Bay Area. Built to your exact specs.";
---

<html lang="en" class="bg-neutral-950 text-white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Custom sheds and home renovations in Tampa Bay Area. Reliable craftsmanship built for your space."
    />
    <meta
      name="keywords"
      content="TOPO, Sheds, Remodeling, Construction, Home, Design"
    />
    <meta name="author" content="TOPO Sheds & Remodeling LLC" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/TOPO_Sheds_Remodeling_logo.svg"
    />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={siteUrl + ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      @import "tailwindcss";
      body {
        font-family: "Inter", sans-serif;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Montserrat", sans-serif;
      }
    </style>
  </head>
  <body class="antialiased">
    <main class="py-24 px-6 max-w-6xl mx-auto sm:max-w-full sm:px-0">
      <slot />
    </main>
  </body>
  <Footer />
</html>
